# 複製為 .env 後填入真實值（.env 已在 .gitignore，請勿上傳）
# 產生密鑰範例：`openssl rand -hex 32`
# 本機開發可全部留空；production 只要動到「必設」兩項就必須是真的隨機值。

# ── 服務監聽 ────────────────────────────────────────────────
PORT=3001
# production 建議 127.0.0.1（前方由 nginx 反代）；需要直連才改 0.0.0.0
HOST=127.0.0.1
# 資料目錄（SQLite vault.db/dy-monitor.db/dy-enter.db + 上傳檔案），建議用絕對路徑
VAULT_DATA_DIR=./data

# ── 必設（H1：production 使用預設值會直接拒絕啟動）──────────
# 管理員密碼（建議 16+ 字元隨機）
VAULT_ADMIN_PASSWORD=change-me-strong-password
# session cookie HMAC 簽名密鑰（至少 32 bytes 隨機）
VAULT_SESSION_SECRET=change-me-64-hex-chars

# ── 反向代理 ────────────────────────────────────────────────
# 僅在「node 位於可信 nginx / CDN 之後且其會覆寫 X-Forwarded-For」時設 1，否則一律 0
TRUST_PROXY=0

# ── production（由部署平台設定）────────────────────────────
# NODE_ENV=production
# 前端靜態目錄：releases 結構下 cwd 沒有 dist/，通常由 ecosystem 設成 <APP_DIR>/current/dist
# （production 預設 <cwd>/dist，只在單層舊結構才正確）
# VAULT_DIST_DIR=/www/wwwroot/lucy-site/current/dist
# 登入失敗鎖定次數 / 窗口（預設 5 次 / 15 分鐘）
# VAULT_LOGIN_RATE_MAX=5

# ── tools：DeepSeek（nav 顯示 CNY 餘額；留空則整區隱藏）─────
# API_KEY=sk-...

# ── tools：抖音（dy-monitor / dy-enter）─────────────────────
# cookie 檔路徑（JSON 陣列或原始 header 字串，建議 chmod 600）；預設 ~/dy_cookies.json
# DY_COOKIE_FILE=/root/dy_cookies.json
# 1 = 停用該引擎（維運 / 測試時）
# DY_MONITOR_DISABLE=0
# DY_ENTER_DISABLE=0
# 開播通知訊息附帶的儀表板連結
# DY_DASHBOARD_URL=https://wolfheluo.com/tools/dy-monitor

# ── tools：LINE 通知（未設時通知仍落庫，ok=0 附原因）────────
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE_TO=

# ── tools：binance-api 假行情（僅測試 / e2e 版面驗證）───────
# BQ_DEMO=0

# ── 平台旗標（放 pm2 ecosystem，一般不要寫進 .env）──────────
# START_SERVER=1         # pm2 fork 模式若不設，server 不會 listen
# NODE_APP_INSTANCE=0    # pm2 注入；非 0 時 dy-monitor 引擎不啟動
