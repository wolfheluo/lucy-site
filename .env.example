# 複製為 .env 後填入真實值（.env 已在 .gitignore，請勿上傳）
# 產生密鑰範例：`openssl rand -hex 32`

# ── 服務監聽 ────────────────────────────────────────────────
PORT=3001
# production 建議 127.0.0.1（前方由 nginx 反代）；需要直連才改 0.0.0.0
HOST=127.0.0.1
# 資料目錄（SQLite vault.db + 上傳檔案），建議用絕對路徑
VAULT_DATA_DIR=./data

# ── 必設（H1：production 使用預設值會直接拒絕啟動）──────────
# 管理員密碼（建議 16+ 字元隨機）
VAULT_ADMIN_PASSWORD=change-me-strong-password
# session cookie HMAC 簽名密鑰（至少 32 bytes 隨機）
VAULT_SESSION_SECRET=change-me-64-hex-chars

# ── 反向代理 ────────────────────────────────────────────────
# 僅在「node 位於可信 nginx / CDN 之後且其會覆寫 X-Forwarded-For」時設 1，否則一律 0
TRUST_PROXY=0

# ── production（由部署平台設定）────────────────────────────
# NODE_ENV=production
# VAULT_DIST_DIR=./dist
# 登入失敗鎖定次數 / 窗口（預設 5 次 / 15 分鐘）
# VAULT_LOGIN_RATE_MAX=5
